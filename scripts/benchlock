#!/usr/bin/env python3
"""Run a command under this checkout's exclusive benchmark lock."""
import fcntl
import os
from pathlib import Path
import subprocess
import sys

if len(sys.argv) < 2:
    raise SystemExit('usage: scripts/benchlock COMMAND [ARG ...]')
lock_path = Path(__file__).resolve().parent.parent / '.cache/bench.lock'
lock_path.parent.mkdir(parents=True, exist_ok=True)
with lock_path.open('a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    raise SystemExit(subprocess.call(sys.argv[1:]))
